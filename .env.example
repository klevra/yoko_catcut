# Host ports (what your machine will use)
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# Container internal ports (what services listen on inside containers)
BACKEND_CONTAINER_PORT=8000
FRONTEND_CONTAINER_PORT=3000

# Container names (optional override)
BACKEND_CONTAINER_NAME=yoko_catcut_backend
FRONTEND_CONTAINER_NAME=yoko_catcut_frontend
